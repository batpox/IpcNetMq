<?xml version="1.0"?>
<!-- Prefer dotnet pack IpcNetMq.csproj; kept for legacy nuget.exe workflows. -->
<package>
  <metadata>
    <id>IpcNetMq</id>
    <version>26.10.10.8</version>
    <authors>Daniel T. Houck</authors>
    <icon>IpcNetMq.png</icon>
    <readme>README.md</readme>
    <description>IPC request/reply communications using NetMQ.</description>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <dependencies>
      <group targetFramework="net48">
        <dependency id="NetMQ" version="4.0.4.3" />
        <dependency id="System.Text.Json" version="10.0.11" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="NetMQ" version="4.0.4.3" />
        <dependency id="System.Text.Json" version="10.0.11" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="NetMQ" version="4.0.4.3" />
        <dependency id="System.Text.Json" version="10.0.11" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin/Release/net48/IpcNetMq.dll" target="lib/net48" />
    <file src="bin/Release/net8.0/IpcNetMq.dll" target="lib/net8.0" />
    <file src="bin/Release/net10.0/IpcNetMq.dll" target="lib/net10.0" />
    <file src="Resources/IpcNetMq.png" target="" />
    <file src="README.md" target="" />
  </files>
</package>
